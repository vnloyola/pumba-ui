{
  "name": "@pumba-ui/tokens",
  "version": "0.0.0",
  "description": "Design tokens for Pumba: DTCG source compiled to CSS variables and TypeScript types.",
  "license": "MIT",
  "homepage": "https://github.com/vnloyola/pumba-ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/vnloyola/pumba-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/vnloyola/pumba-ui/issues"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "dtcg",
    "oklch",
    "dark-mode"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "!dist/figma.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"scripts/*.test.mjs\""
  },
  "devDependencies": {
    "style-dictionary": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
