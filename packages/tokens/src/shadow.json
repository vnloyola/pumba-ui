{
  "shadow": {
    "sm": {
      "$value": {
        "color": "oklch(0 0 0 / 0.08)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$type": "shadow"
    },
    "md": {
      "$value": {
        "color": "oklch(0 0 0 / 0.12)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "8px",
        "spread": "-1px"
      },
      "$type": "shadow"
    },
    "lg": {
      "$value": {
        "color": "oklch(0 0 0 / 0.16)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "24px",
        "spread": "-4px"
      },
      "$type": "shadow"
    }
  }
}
