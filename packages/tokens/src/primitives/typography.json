{
  "primitive": {
    "font-family": {
      "sans": {
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
        "$type": "fontFamily"
      }
    },
    "font-size": {
      "$description": "Type scale in rem so it follows the user's browser font size. md is the 1rem body size.",
      "xs": {
        "$value": "0.75rem",
        "$type": "dimension"
      },
      "sm": {
        "$value": "0.875rem",
        "$type": "dimension"
      },
      "md": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "lg": {
        "$value": "1.125rem",
        "$type": "dimension"
      },
      "xl": {
        "$value": "1.25rem",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "1.5rem",
        "$type": "dimension"
      },
      "3xl": {
        "$value": "1.875rem",
        "$type": "dimension"
      },
      "4xl": {
        "$value": "2.25rem",
        "$type": "dimension"
      },
      "5xl": {
        "$value": "3rem",
        "$type": "dimension"
      }
    },
    "font-weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      }
    },
    "line-height": {
      "$description": "Unitless: multiplied by the element's own font size, so it scales with it.",
      "none": {
        "$value": 1,
        "$type": "number"
      },
      "tight": {
        "$value": 1.25,
        "$type": "number"
      },
      "snug": {
        "$value": 1.375,
        "$type": "number"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number"
      },
      "relaxed": {
        "$value": 1.625,
        "$type": "number"
      }
    },
    "letter-spacing": {
      "$description": "In em so tracking scales with the font size.",
      "tight": {
        "$value": "-0.025em",
        "$type": "dimension"
      },
      "normal": {
        "$value": "0em",
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.025em",
        "$type": "dimension"
      }
    }
  }
}
