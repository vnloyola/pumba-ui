{
  "primitive": {
    "motion": {
      "duration": {
        "fast": {
          "$value": "100ms",
          "$type": "duration"
        },
        "normal": {
          "$value": "200ms",
          "$type": "duration"
        },
        "slow": {
          "$value": "300ms",
          "$type": "duration"
        }
      },
      "easing": {
        "standard": {
          "$value": [0.2, 0, 0, 1],
          "$type": "cubicBezier"
        },
        "in": {
          "$value": [0.4, 0, 1, 1],
          "$type": "cubicBezier"
        },
        "out": {
          "$value": [0, 0, 0.2, 1],
          "$type": "cubicBezier"
        }
      }
    }
  }
}
