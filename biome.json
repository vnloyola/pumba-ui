{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/storybook-static",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!.claude/worktrees",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@radix-ui/react-icons": "Import icons from packages/ui/src/icons.ts, the only module that may import @radix-ui/react-icons.",
              "lucide-react": "Import icons from packages/ui/src/icons.ts, the only module that may import the icon package."
            },
            "patterns": [
              {
                "group": ["@radix-ui/react-icons/**"],
                "message": "Import icons from packages/ui/src/icons.ts, the only module that may import @radix-ui/react-icons."
              },
              {
                "group": ["lucide-react/**"],
                "message": "Import icons from packages/ui/src/icons.ts, the only module that may import the icon package."
              }
            ]
          }
        }
      },
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": true
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["**", "!packages/ui/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/icons.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
